# Copy to .env and fill in values. Do not commit your real .env.

# ─── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────
# Async DSN form. asyncpg, not psycopg.
# Local dev: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/postgres

# Production: use the Neon `direct` connection string and rewrite the
# scheme to postgresql+asyncpg:// (Neon gives you postgresql://...).

# ─── Auth ─────────────────────────────────────────────────────────────
# MUST match the NEXTAUTH_SECRET used by the Studio Next.js app — this
# backend verifies the same JWT.
NEXTAUTH_SECRET=replace-me-with-a-32-byte-random-string

# Optional: enforce `aud` claim on incoming tokens.
# JWT_AUDIENCE=uod-backend

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of Studio origins permitted to call the API.
CORS_ORIGINS=["http://localhost:3000", "https://ontologystudio.netlify.app"]
